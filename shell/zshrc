# Vedran's Zsh Configuration (macOS)

# Keep PATH free of duplicate entries (zsh keeps $path and $PATH in sync)
typeset -U path

# ---------------------------------------------------------------------------
# Oh My Zsh
# ---------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""   # prompt is defined manually below

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    colored-man-pages
    command-not-found
)

# Homebrew-shipped completions must be on fpath before Oh My Zsh runs compinit
for dir in /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions; do
    [[ -d "$dir" ]] && fpath=("$dir" $fpath)
done
unset dir

[[ -d "$ZSH" ]] && source "$ZSH/oh-my-zsh.sh"

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
export LANG=en_US.UTF-8
export EDITOR='nvim'

# Secrets (e.g. private registry tokens) live in ~/.zshenv, not in this repo.

# ---------------------------------------------------------------------------
# PATH and tool managers
# ---------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# Homebrew (Apple Silicon first, Intel fallback)
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Go (Homebrew)
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"
if [[ -d "/opt/homebrew/opt/go/libexec" ]]; then
    export GOROOT="/opt/homebrew/opt/go/libexec"
    export PATH="$GOROOT/bin:$PATH"
fi

# OpenJDK (Homebrew)
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Maestro
export PATH="$PATH:$HOME/.maestro/bin"

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
